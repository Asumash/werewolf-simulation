# OpenRouter を使う場合（推奨）
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI 直で使う場合は smoke_llm.py の provider を openai にし、以下を設定
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 使い方:
#   1) このファイルを .env にコピー
#        cp .env.example .env
#   2) 実際のキーを記入（.env は .gitignore 済みでコミットされません）
#   3) python smoke_llm.py
